{
  "name": "smart-expense-tracker",
  "version": "1.0.0",
  "description": "Smart Expense & Budget Tracker: track expenses and income, set monthly budgets, and get spending insights. Node.js, Express, MongoDB, EJS, Tailwind CSS.",
  "main": "server.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k -n css,server \"npm:watch:css\" \"nodemon server.js\"",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --watch",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand",
    "test:unit": "jest tests/unit"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.5",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.4.9",
    "compression": "^1.8.0",
    "connect-mongo": "^5.1.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "method-override": "^3.0.0",
    "mongoose": "^8.15.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.8",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "mongodb-memory-server-core": "^10.4.3",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.1",
    "tailwindcss": "^4.1.8"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/globalSetup.js",
    "globalTeardown": "./tests/globalTeardown.js",
    "testTimeout": 30000
  },
  "nodemonConfig": {
    "ext": "js,ejs,json",
    "ignore": [
      "public/*",
      "tests/*"
    ]
  }
}
