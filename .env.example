# Copy this file to .env and fill in your values. Never commit .env.

# MongoDB connection string - either a local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/smart_expense_tracker
# ...or a free MongoDB Atlas cluster (see DEPLOY.md):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/smart_expense_tracker?retryWrites=true&w=majority

# Signs the session cookie. Use a long random value; required in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

PORT=3000

# Time zone used for "today" and the current month.
APP_TIMEZONE=Asia/Kolkata

# Optional
# DEMO_ENABLED=false          # hide the "Try the demo" button
# AUTH_RATE_LIMIT=20          # login/register attempts per 15 minutes per IP
# SESSION_STORE=memory        # quick experiments only: sessions are lost on restart
