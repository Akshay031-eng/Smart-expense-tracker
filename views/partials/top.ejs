<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? `${title} – ${appName}` : appName %></title>
  <meta name="description" content="Track expenses and income, set monthly budgets for each category and get plain-language spending insights.">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <script src="/js/theme.js"></script>
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/app.js" defer></script>
  <% if (locals.withCharts) { %>
  <script src="/vendor/chart.js/chart.umd.min.js" defer></script>
  <script src="/js/dashboard.js" defer></script>
  <% } %>
</head>
<body class="min-h-screen bg-paper font-sans text-ink antialiased">
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-sheet focus:px-4 focus:py-2">Skip to content</a>
<% const nav = [
  { href: '/dashboard', label: 'Dashboard', icon: 'dashboard' },
  { href: '/transactions', label: 'Transactions', icon: 'list' },
  { href: '/budgets', label: 'Budgets', icon: 'target' },
  { href: '/settings', label: 'Settings', icon: 'settings' },
]; %>
<% if (currentUser) { %>
  <aside class="fixed inset-y-0 left-0 z-30 hidden w-64 flex-col border-r border-rule bg-sheet px-4 py-6 lg:flex">
    <div class="px-2"><%- include('brand') %></div>
    <nav class="mt-8 flex flex-col gap-1" aria-label="Main">
      <% nav.forEach((item) => { %>
        <a href="<%= item.href %>" class="nav-link" <%- isActive(item.href) ? 'aria-current="page"' : '' %>>
          <%- include('icon', { name: item.icon }) %><%= item.label %>
        </a>
      <% }) %>
    </nav>
    <a href="/transactions/new" class="btn btn-primary mt-6"><%- include('icon', { name: 'plus', cls: 'h-4 w-4' }) %>Add expense</a>
    <div class="mt-auto border-t border-rule pt-4">
      <p class="truncate px-2 text-sm font-semibold"><%= currentUser.name %></p>
      <p class="truncate px-2 text-xs text-ink-soft"><%= currentUser.email %></p>
      <div class="mt-3 flex items-center gap-2">
        <button type="button" class="btn btn-quiet btn-sm" data-theme-toggle aria-label="Switch between light and dark theme"><%- include('icon', { name: 'moon', cls: 'h-4 w-4' }) %>Theme</button>
        <form action="/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-quiet btn-sm"><%- include('icon', { name: 'logout', cls: 'h-4 w-4' }) %>Sign out</button>
        </form>
      </div>
    </div>
  </aside>

  <header class="sticky top-0 z-30 border-b border-rule bg-sheet/95 backdrop-blur lg:hidden">
    <div class="flex items-center justify-between px-4 py-3">
      <%- include('brand') %>
      <details class="group relative" data-menu>
        <summary class="btn btn-quiet btn-sm cursor-pointer list-none" aria-label="Open menu"><%- include('icon', { name: 'menu', cls: 'h-5 w-5' }) %></summary>
        <div class="absolute right-0 mt-2 w-64 rounded-xl border border-rule bg-sheet p-2 shadow-lg">
          <nav class="flex flex-col gap-1" aria-label="Main">
            <% nav.forEach((item) => { %>
              <a href="<%= item.href %>" class="nav-link" <%- isActive(item.href) ? 'aria-current="page"' : '' %>><%- include('icon', { name: item.icon }) %><%= item.label %></a>
            <% }) %>
          </nav>
          <div class="mt-2 flex items-center gap-2 border-t border-rule px-1 pt-3">
            <button type="button" class="btn btn-quiet btn-sm" data-theme-toggle>Theme</button>
            <form action="/logout" method="post" class="ml-auto">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-quiet btn-sm">Sign out</button>
            </form>
          </div>
        </div>
      </details>
    </div>
  </header>

  <main id="main" class="lg:pl-64">
    <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-10 lg:py-10">
      <% if (currentUser.isDemo) { %>
        <p class="mb-5 rounded-lg border border-rule bg-sheet px-4 py-2.5 text-sm text-ink-soft">
          You're exploring the shared demo account. <a class="link" href="/register">Create your own account</a> to keep your data private.
        </p>
      <% } %>
      <%- include('flash') %>
<% } else { %>
  <header class="border-b border-rule bg-sheet">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
      <%- include('brand') %>
      <nav class="flex items-center gap-2" aria-label="Account">
        <button type="button" class="btn btn-quiet btn-sm" data-theme-toggle aria-label="Switch between light and dark theme"><%- include('icon', { name: 'moon', cls: 'h-4 w-4' }) %></button>
        <a href="/login" class="btn btn-quiet btn-sm">Sign in</a>
        <a href="/register" class="btn btn-primary btn-sm">Create account</a>
      </nav>
    </div>
  </header>
  <main id="main">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:py-14">
      <%- include('flash') %>
<% } %>
