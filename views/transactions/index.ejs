<%- include('../partials/top') %>
<% const returnTo = `/transactions${queryString({})}`; %>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="heading-display text-3xl sm:text-4xl">Transactions</h1>
    <p class="mt-1.5 text-sm text-ink-soft">Every expense and income you've recorded. Filter, edit or export them.</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/transactions/new?returnTo=<%= encodeURIComponent(returnTo) %>" class="btn btn-primary"><%- include('../partials/icon', { name: 'plus', cls: 'h-4 w-4' }) %>Add expense</a>
    <a href="/transactions/new?type=income&returnTo=<%= encodeURIComponent(returnTo) %>" class="btn btn-quiet">Add income</a>
    <a href="/transactions/export<%= queryString({ page: 1 }) %>" class="btn btn-quiet"><%- include('../partials/icon', { name: 'download', cls: 'h-4 w-4' }) %>Export CSV</a>
  </div>
</div>

<form action="/transactions" method="get" class="sheet mt-6 grid gap-4 p-4 sm:grid-cols-2 sm:p-5 lg:grid-cols-6" role="search" aria-label="Filter transactions">
  <div class="lg:col-span-2">
    <label for="q" class="label">Search notes</label>
    <div class="relative">
      <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-ink-soft"><%- include('../partials/icon', { name: 'search', cls: 'h-4 w-4' }) %></span>
      <input id="q" name="q" type="search" value="<%= filters.q %>" placeholder="e.g. Swiggy, rent" class="field pl-9">
    </div>
  </div>
  <div>
    <label for="type" class="label">Type</label>
    <select id="type" name="type" class="field">
      <option value="">All</option>
      <option value="expense" <%= filters.type === 'expense' ? 'selected' : '' %>>Expenses</option>
      <option value="income" <%= filters.type === 'income' ? 'selected' : '' %>>Income</option>
    </select>
  </div>
  <div>
    <label for="category" class="label">Category</label>
    <select id="category" name="category" class="field">
      <option value="">All</option>
      <optgroup label="Expense">
        <% expenseCategories.forEach((c) => { %><option value="<%= c.id %>" <%= filters.category === c.id ? 'selected' : '' %>><%= c.label %></option><% }) %>
      </optgroup>
      <optgroup label="Income">
        <% incomeCategories.forEach((c) => { %><option value="<%= c.id %>" <%= filters.category === c.id ? 'selected' : '' %>><%= c.label %></option><% }) %>
      </optgroup>
    </select>
  </div>
  <div>
    <label for="from" class="label">From</label>
    <input id="from" name="from" type="date" value="<%= filters.from %>" class="field">
  </div>
  <div>
    <label for="to" class="label">To</label>
    <input id="to" name="to" type="date" value="<%= filters.to %>" class="field">
  </div>
  <div class="flex flex-wrap items-end gap-3 sm:col-span-2 lg:col-span-6">
    <div>
      <label for="sort" class="label">Sort by</label>
      <select id="sort" name="sort" class="field">
        <% [['newest', 'Newest first'], ['oldest', 'Oldest first'], ['highest', 'Highest amount'], ['lowest', 'Lowest amount']].forEach(([value, text]) => { %>
          <option value="<%= value %>" <%= filters.sort === value ? 'selected' : '' %>><%= text %></option>
        <% }) %>
      </select>
    </div>
    <button class="btn btn-primary">Apply filters</button>
    <% if (hasFilters) { %><a href="/transactions" class="btn btn-quiet">Clear</a><% } %>
  </div>
</form>

<section class="sheet mt-6 overflow-hidden" aria-label="Transaction list">
  <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-rule px-4 py-3 text-sm sm:px-6">
    <p class="text-ink-soft">
      <% if (pagination.total) { %>Showing <%= pagination.from %>–<%= pagination.to %> of <%= pagination.total %><% } else { %>No transactions<% } %>
    </p>
    <p class="flex flex-wrap gap-x-5 gap-y-1">
      <span>Income <span class="amount font-semibold text-credit">+<%= money(totals.income) %></span></span>
      <span>Expenses <span class="amount font-semibold">−<%= money(totals.expense) %></span></span>
      <span>Net <span class="amount font-semibold <%= totals.income - totals.expense < 0 ? 'text-debit' : '' %>"><%= totals.income - totals.expense < 0 ? '−' : '' %><%= money(Math.abs(totals.income - totals.expense)) %></span></span>
    </p>
  </div>

  <% if (transactions.length) { %>
    <div class="overflow-x-auto">
      <table class="ledger w-full">
        <thead>
          <tr>
            <th class="sm:pl-6">Date</th>
            <th>Description</th>
            <th class="hidden md:table-cell">Category</th>
            <th class="hidden lg:table-cell">Paid with</th>
            <th class="text-right">Amount</th>
            <th class="sm:pr-6"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% transactions.forEach((t) => { const cat = category(t.category); %>
            <tr>
              <td class="whitespace-nowrap text-ink-soft sm:pl-6"><%= formatDate(t.date) %></td>
              <td>
                <p class="font-medium"><%= t.description || cat.label %></p>
                <p class="mt-0.5 inline-flex items-center gap-1.5 text-xs text-ink-soft md:hidden"><span class="h-2 w-2 rounded-full <%= cat.dot %>"></span><%= cat.label %></p>
              </td>
              <td class="hidden md:table-cell"><span class="inline-flex items-center gap-2 text-ink-soft"><span class="h-2 w-2 rounded-full <%= cat.dot %>"></span><%= cat.label %></span></td>
              <td class="hidden text-ink-soft lg:table-cell"><%= paymentMethod(t.paymentMethod).label %></td>
              <td class="text-right"><%- include('../partials/tx-amount', { t }) %></td>
              <td class="sm:pr-6">
                <div class="flex justify-end gap-1">
                  <a href="/transactions/<%= t._id %>/edit?returnTo=<%= encodeURIComponent(returnTo) %>" class="btn btn-quiet btn-sm px-2" aria-label="Edit <%= t.description || cat.label %>"><%- include('../partials/icon', { name: 'pencil', cls: 'h-4 w-4' }) %></a>
                  <form action="/transactions/<%= t._id %>" method="post" data-confirm="Delete this transaction? This can't be undone.">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="_method" value="DELETE">
                    <input type="hidden" name="returnTo" value="<%= returnTo %>">
                    <button class="btn btn-quiet btn-sm px-2 hover:text-debit" aria-label="Delete <%= t.description || cat.label %>"><%- include('../partials/icon', { name: 'trash', cls: 'h-4 w-4' }) %></button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (pagination.pages > 1) { %>
      <nav class="flex items-center justify-between border-t border-rule px-4 py-3 sm:px-6" aria-label="Pagination">
        <% if (pagination.page > 1) { %>
          <a class="btn btn-quiet btn-sm" href="/transactions<%= queryString({ page: pagination.page - 1 }) %>"><%- include('../partials/icon', { name: 'chevronLeft', cls: 'h-4 w-4' }) %>Previous</a>
        <% } else { %><span></span><% } %>
        <span class="text-sm text-ink-soft">Page <%= pagination.page %> of <%= pagination.pages %></span>
        <% if (pagination.page < pagination.pages) { %>
          <a class="btn btn-quiet btn-sm" href="/transactions<%= queryString({ page: pagination.page + 1 }) %>">Next<%- include('../partials/icon', { name: 'chevronRight', cls: 'h-4 w-4' }) %></a>
        <% } else { %><span></span><% } %>
      </nav>
    <% } %>
  <% } else if (hasFilters) { %>
    <div class="px-6 py-12 text-center">
      <p class="font-semibold">No transactions match these filters</p>
      <p class="mt-1 text-sm text-ink-soft">Try a wider date range or a different category.</p>
      <a href="/transactions" class="btn btn-quiet mt-5">Clear filters</a>
    </div>
  <% } else { %>
    <div class="px-6 py-12 text-center">
      <p class="font-semibold">No transactions yet</p>
      <p class="mt-1 text-sm text-ink-soft">Add your first expense, like today's lunch or a bus ticket.</p>
      <a href="/transactions/new" class="btn btn-primary mt-5">Add expense</a>
    </div>
  <% } %>
</section>
<%- include('../partials/bottom') %>
